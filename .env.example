# ==============================
# Server
# ==============================
PORT=3000

# development | production
NODE_ENV=development

# ==============================
# URLs
# ==============================
# Used in password reset email links (authService.js -> forgotPassword)
# and as a fallback allowed origin for CSRF (csrf.js -> validateOrigin)
FRONTEND_URL=http://localhost:5173

# Legacy fallback allowed origin for production CSRF validation
# Only used if ALLOWED_ORIGINS is not set
PRODUCTION_URL=

# ==============================
# Email (Nodemailer via Gmail)
# ==============================
# Gmail address used to send password reset emails
GMAIL_USER=

# Gmail App Password (NOT your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2FA enabled on the Google account
GMAIL_APP_PASS=

# ==============================
# Database (MySQL)
# ==============================
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=
DB_PORT=3306

# Connection pool settings (mysql2/promise pool config)
DB_POOL_SIZE=10
DB_MAX_IDLE=10

# ==============================
# JWT (RS256)
# ==============================
# Paths to RSA key pair, auto-generated by scripts/bootstrap.js if missing
JWT_PUBLIC_PATH=./keys/public.key
JWT_PRIVATE_PATH=./keys/private.key

# Token lifetime, e.g. "1h", "15m", "7d" (jsonwebtoken expiresIn format)
JWT_EXPIRES_IN=1h

# ==============================
# CSRF Protection
# ==============================
# HMAC signing secret for CSRF tokens — generate with: openssl rand -base64 32
CSRF_SECRET=

# Set "true" only if frontend and backend are on different origins over HTTPS
# Requires COOKIE_SECURE=true. Do NOT use over plain HTTP.
ALLOW_CROSS_SITE_CSRF=false

# Force secure (HTTPS-only) cookies even outside production
# Required if ALLOW_CROSS_SITE_CSRF=true
COOKIE_SECURE=false

# Disables CSRF checks entirely — dev/testing only (e.g. Postman)
# Throws at boot if set to "true" while NODE_ENV=production
DISABLE_CSRF=false

# Comma-separated list of allowed origins for validateOrigin middleware
# e.g. http://localhost:5173,https://app.example.com
ALLOWED_ORIGINS=